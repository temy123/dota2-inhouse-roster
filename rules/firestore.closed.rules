rules_version = '2';

/* ============================================================
   Firestore 보안 규칙 — 도타2 인하우스 로스터 (2. 접수 마감 모드)
   -----------------------------------------------------------
   - 읽기(read): 차단
   - 쓰기(create, update, delete): 모두 차단
   - 웹페이지에서 선수가 제출을 시도해도 권한 거부(Permission Denied)됩니다.
   ============================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    match /rosters/{docId} {
      allow read, write: if false;
    }

    // 로스터 접수 마감과 무관하게 익명 피드백은 새 문서 생성만 항상 허용
    match /feedbacks/{docId} {
      function validFeedbackShape(d) {
        return d.keys().hasOnly([
          'balanceFeedback', 'teamworkFeedback', 'overallFeedback',
          'additionFeedback', 'createdAt'
        ])
        && d.keys().hasAll([
          'balanceFeedback', 'teamworkFeedback', 'overallFeedback',
          'additionFeedback', 'createdAt'
        ]);
      }

      function validFeedbackText(value) {
        return value is string
          && value.size() > 0
          && value.size() <= 2000
          && value.matches('.*\\S.*');
      }

      allow read: if false;
      allow create: if
        validFeedbackShape(request.resource.data)
        && validFeedbackText(request.resource.data.balanceFeedback)
        && validFeedbackText(request.resource.data.teamworkFeedback)
        && validFeedbackText(request.resource.data.overallFeedback)
        && validFeedbackText(request.resource.data.additionFeedback)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // 공개 리더보드: 접수 마감 상태여도 공개 리더보드는 조회 가능
    match /public_leaderboard/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // 그 외 모든 문서 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
